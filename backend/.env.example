# Local MongoDB (default for development)
MONGODB_URL=mongodb://127.0.0.1:27017/tEStroDB

# MongoDB Atlas: comment out MONGODB_URL and use these (password is URL-encoded automatically)
# MONGO_ATLAS_USER=myuser
# MONGO_ATLAS_PASSWORD=
# MONGO_ATLAS_HOST=cluster0.xxxxx.mongodb.net

# Optional; also used when building an Atlas URI from split vars
MONGO_DB_NAME=tEStroDB

# Or one line for Atlas / other hosts (no placeholders):
# MONGO_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/tEStroDB

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

PORT=5000
NODE_ENV=development

FRONTEND_URL=http://localhost:5173

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Allow live modules (traffic/api-rate/sql/xss/path/auth live mode) to target non-localhost URLs.
# Keep false for safer local lab mode.
# ALLOW_LIVE_TESTING=false

# Optional: traffic & rate-test plan ceilings (clamped to safe ranges in code)
# PLAN_FREE_TRAFFIC_API_RPM=40
# PLAN_PREMIUM_TRAFFIC_API_RPM=600
# PLAN_ADMIN_TRAFFIC_API_RPM=1000
# PLAN_FREE_LOAD_TOTAL=50
# PLAN_PREMIUM_LOAD_TOTAL=1000
# PLAN_FREE_RATE_BATCH_MAX=40
# PLAN_PREMIUM_RATE_BATCH_MAX=600
